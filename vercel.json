{
  "framework": null,
  "buildCommand": null,
  "installCommand": "npm install && npm run build",
  "rewrites": [
    { "source": "/", "destination": "/landing.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/api/entries/:id/action-points/:apId", "destination": "/api/entries" },
    { "source": "/api/entries/:id/messages", "destination": "/api/entries" },
    { "source": "/api/entries/:id/audio", "destination": "/api/entries" },
    { "source": "/api/entries/:id/tags", "destination": "/api/entries" },
    { "source": "/api/entries/:id", "destination": "/api/entries" },
    { "source": "/api/ask/:id/messages", "destination": "/api/ask" },
    { "source": "/api/auth/login", "destination": "/api/auth" },
    { "source": "/api/auth/logout", "destination": "/api/auth" },
    { "source": "/api/auth/me", "destination": "/api/auth" },
    { "source": "/api/auth/password-reset", "destination": "/api/auth" },
    { "source": "/api/auth/picture", "destination": "/api/auth" },
    { "source": "/api/auth/profile", "destination": "/api/auth" },
    { "source": "/api/auth/signup", "destination": "/api/auth" }
  ],
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 13 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://esm.sh https://us.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' https://us.i.posthog.com https://esm.sh; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ]
}
